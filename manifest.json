{
  "manifest_version": 3,
  "name": "PoE1 Gem Hover",
  "version": "1.7.0",
  "description": "Hover a skill gem on maxroll.gg PoE1 pages to see the earliest vendor purchase and free quest reward, by class.",
  "browser_specific_settings": { "gecko": { "id": "poe1-gem-hover@local" } },
  "content_scripts": [
    {
      "matches": ["https://maxroll.gg/poe/*"],
      "js": ["format.js", "content.js"],
      "css": ["tooltip.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["data/gems.json"], "matches": ["https://maxroll.gg/*"] }
  ]
}
